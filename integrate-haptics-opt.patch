diff --git a/src/AmtPtpConfigGui/HapticsActuator.cs b/src/AmtPtpConfigGui/HapticsActuator.cs
new file mode 100644
index 0000000..c45edac
--- /dev/null
+++ b/src/AmtPtpConfigGui/HapticsActuator.cs
@@ -0,0 +1,214 @@
+using System;
+using System.Runtime.InteropServices;
+using ActuatorHandle = Microsoft.Win32.SafeHandles.SafeFileHandle;
+
+namespace AmtPtpConfigGui
+{
+    /// <summary>
+    /// User-mode access to the haptic actuator driver
+    /// (src/AmtHapticDeviceUsbKm). Mirrors its Public.h: keep both in sync and
+    /// bump AMT_HAPTIC_INTERFACE_VERSION there and InterfaceVersion here on any
+    /// layout change.
+    /// </summary>
+    internal static class HapticsActuator
+    {
+        public enum FindResult
+        {
+            Found,
+            NotInstalled,
+            Multiple,
+            Error
+        }
+
+        // Must match GUID_DEVINTERFACE_AMT_HAPTIC in Public.h.
+        private static readonly Guid InterfaceGuid = new Guid("15e33c40-8ec9-4ab3-afe1-b3e6215f4499");
+
+        // Must match AMT_HAPTIC_INTERFACE_VERSION in Public.h.
+        private const uint InterfaceVersion = 1;
+
+        // CTL_CODE(FILE_DEVICE_UNKNOWN, 0x800, METHOD_BUFFERED, FILE_READ_DATA)
+        // and + 1 with FILE_WRITE_DATA: IOCTL_AMT_HAPTIC_GET_INFO / _CLICK.
+        private const uint IoctlGetInfo = 0x00226000;
+        private const uint IoctlClick = 0x0022A004;
+
+        // sizeof(AMT_HAPTIC_INFO) and sizeof(AMT_HAPTIC_CLICK_REQUEST).
+        private const int InfoSize = 48;
+        private const uint ClickRequestSize = 8;
+
+        // The driver's own 100 ms click cooldown (STATUS_DEVICE_BUSY) surfaces
+        // as ERROR_BUSY. It is flow control, not a transport failure.
+        public const int ErrorBusy = 170;
+
+        private const uint DigcfPresent = 0x02;
+        private const uint DigcfDeviceInterface = 0x10;
+        private const uint GenericReadWrite = 0xC0000000;
+        private const uint FileShareReadWrite = 3;
+        private const uint OpenExisting = 3;
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct DeviceInterfaceData
+        {
+            public int Size;
+            public Guid InterfaceClassGuid;
+            public int Flags;
+            public IntPtr Reserved;
+        }
+
+        [DllImport("setupapi.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+        private static extern IntPtr SetupDiGetClassDevs(ref Guid classGuid, string? enumerator, IntPtr parent, uint flags);
+
+        [DllImport("setupapi.dll", SetLastError = true)]
+        private static extern bool SetupDiEnumDeviceInterfaces(IntPtr set, IntPtr info, ref Guid classGuid, uint index, ref DeviceInterfaceData data);
+
+        [DllImport("setupapi.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+        private static extern bool SetupDiGetDeviceInterfaceDetail(IntPtr set, ref DeviceInterfaceData data, IntPtr detail, uint size, out uint required, IntPtr info);
+
+        [DllImport("setupapi.dll")]
+        private static extern bool SetupDiDestroyDeviceInfoList(IntPtr set);
+
+        [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+        private static extern ActuatorHandle CreateFile(string path, uint access, uint share, IntPtr security, uint disposition, uint flags, IntPtr template);
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool DeviceIoControl(ActuatorHandle handle, uint code, ref ClickRequest input, uint inputSize, IntPtr output, uint outputSize, out uint returned, IntPtr overlapped);
+
+        [DllImport("kernel32.dll", SetLastError = true)]
+        private static extern bool DeviceIoControl(ActuatorHandle handle, uint code, IntPtr input, uint inputSize, IntPtr output, uint outputSize, out uint returned, IntPtr overlapped);
+
+        [StructLayout(LayoutKind.Sequential)]
+        private struct ClickRequest
+        {
+            public uint StructVersion;
+            public uint Waveform;
+        }
+
+        /// <summary>The driver's AMT_HAPTIC_INFO (diagnostics and version).</summary>
+        public readonly record struct Info(
+            uint StructVersion,
+            uint WaveformCount,
+            uint MinClickIntervalMs,
+            uint ClicksDelivered,
+            uint ClicksThrottled,
+            uint ClicksFailed,
+            int LastStatus);
+
+        /// <summary>
+        /// Locates the single bound actuator interface. A second match is
+        /// refused rather than guessed at: the driver only binds MI_03 of one
+        /// trackpad.
+        /// </summary>
+        public static FindResult Find(out string? path)
+        {
+            path = null;
+            Guid guid = InterfaceGuid;
+            IntPtr set = SetupDiGetClassDevs(ref guid, null, IntPtr.Zero, DigcfPresent | DigcfDeviceInterface);
+            if (set == IntPtr.Zero || set == new IntPtr(-1))
+                return FindResult.Error;
+
+            try
+            {
+                var first = new DeviceInterfaceData { Size = Marshal.SizeOf<DeviceInterfaceData>() };
+                if (!SetupDiEnumDeviceInterfaces(set, IntPtr.Zero, ref guid, 0, ref first))
+                    return FindResult.NotInstalled;
+
+                var second = new DeviceInterfaceData { Size = first.Size };
+                if (SetupDiEnumDeviceInterfaces(set, IntPtr.Zero, ref guid, 1, ref second))
+                    return FindResult.Multiple;
+
+                SetupDiGetDeviceInterfaceDetail(set, ref first, IntPtr.Zero, 0, out uint needed, IntPtr.Zero);
+                if (needed < 6)
+                    return FindResult.Error;
+
+                IntPtr buffer = Marshal.AllocHGlobal((int)needed);
+                try
+                {
+                    // SP_DEVICE_INTERFACE_DETAIL_DATA_W.cbSize is the fixed
+                    // header size: 8 on 64-bit (padded), 6 on 32-bit.
+                    Marshal.WriteInt32(buffer, IntPtr.Size == 8 ? 8 : 6);
+                    if (!SetupDiGetDeviceInterfaceDetail(set, ref first, buffer, needed, out needed, IntPtr.Zero))
+                        return FindResult.Error;
+
+                    path = Marshal.PtrToStringUni(IntPtr.Add(buffer, 4));
+                    return path == null ? FindResult.Error : FindResult.Found;
+                }
+                finally
+                {
+                    Marshal.FreeHGlobal(buffer);
+                }
+            }
+            finally
+            {
+                SetupDiDestroyDeviceInfoList(set);
+            }
+        }
+
+        /// <summary>
+        /// Null when the interface cannot be opened or its driver speaks a
+        /// different interface version than this build: a client and a driver
+        /// from different revisions must not exchange buffers.
+        /// </summary>
+        public static ActuatorHandle? Open(string path)
+        {
+            ActuatorHandle handle = CreateFile(path, GenericReadWrite, FileShareReadWrite, IntPtr.Zero, OpenExisting, 0, IntPtr.Zero);
+            if (handle.IsInvalid)
+            {
+                handle.Dispose();
+                return null;
+            }
+
+            if (!TryGetInfo(handle, out Info info) || info.StructVersion != InterfaceVersion)
+            {
+                handle.Dispose();
+                return null;
+            }
+
+            return handle;
+        }
+
+        public static bool TryGetInfo(ActuatorHandle handle, out Info info)
+        {
+            info = default;
+            IntPtr buffer = Marshal.AllocHGlobal(InfoSize);
+            try
+            {
+                if (!DeviceIoControl(handle, IoctlGetInfo, IntPtr.Zero, 0, buffer, InfoSize, out uint returned, IntPtr.Zero)
+                    || returned < InfoSize)
+                {
+                    return false;
+                }
+
+                info = new Info(
+                    (uint)Marshal.ReadInt32(buffer, 0),
+                    (uint)Marshal.ReadInt32(buffer, 4),
+                    (uint)Marshal.ReadInt32(buffer, 8),
+                    (uint)Marshal.ReadInt32(buffer, 12),
+                    (uint)Marshal.ReadInt32(buffer, 16),
+                    (uint)Marshal.ReadInt32(buffer, 20),
+                    Marshal.ReadInt32(buffer, 24));
+                return true;
+            }
+            finally
+            {
+                Marshal.FreeHGlobal(buffer);
+            }
+        }
+
+        /// <summary>
+        /// waveform: 0 = light, 1 = firm (AMT_HAPTIC_WAVEFORM_*). Returns 0 on
+        /// success, otherwise the Win32 error of the failed IOCTL.
+        /// </summary>
+        public static int Click(ActuatorHandle handle, int waveform)
+        {
+            var request = new ClickRequest
+            {
+                StructVersion = InterfaceVersion,
+                Waveform = waveform == 1 ? 1u : 0u,
+            };
+
+            if (DeviceIoControl(handle, IoctlClick, ref request, ClickRequestSize, IntPtr.Zero, 0, out _, IntPtr.Zero))
+                return 0;
+
+            return Marshal.GetLastWin32Error();
+        }
+    }
+}
diff --git a/src/AmtPtpConfigGui/HapticsConfig.cs b/src/AmtPtpConfigGui/HapticsConfig.cs
new file mode 100644
index 0000000..1c310bf
--- /dev/null
+++ b/src/AmtPtpConfigGui/HapticsConfig.cs
@@ -0,0 +1,37 @@
+namespace AmtPtpConfigGui.Native
+{
+    /// <summary>
+    /// Pressure-haptics ("second click") settings. Unlike Palm/Pointer/Scroll
+    /// these are not driver configuration: they belong to the WellspringHaptics
+    /// helper, which the GUI pushes them to (see HapticsClient). They still live
+    /// in the profile so Save / Reset / profile switching / import / export
+    /// treat them like every other setting.
+    /// </summary>
+    public sealed class HapticsConfig
+    {
+        public const int ThresholdMin = 50;
+        public const int ThresholdMax = 1000;
+        public const int ThresholdStep = 5;
+        public const int WaveformLight = 0;
+        public const int WaveformFirm = 1;
+
+        public bool Enabled { get; set; } = true;
+        public int Threshold { get; set; } = 265;
+        public int Waveform { get; set; } = WaveformFirm;
+
+        public static HapticsConfig Default => new HapticsConfig();
+
+        public HapticsConfig Clamped()
+        {
+            int threshold = System.Math.Clamp(Threshold, ThresholdMin, ThresholdMax);
+            threshold = (int)System.Math.Round(threshold / (double)ThresholdStep) * ThresholdStep;
+
+            return new HapticsConfig
+            {
+                Enabled = Enabled,
+                Threshold = threshold,
+                Waveform = Waveform == WaveformLight ? WaveformLight : WaveformFirm,
+            };
+        }
+    }
+}
diff --git a/src/AmtPtpConfigGui/HapticsEngine.cs b/src/AmtPtpConfigGui/HapticsEngine.cs
new file mode 100644
index 0000000..83f8463
--- /dev/null
+++ b/src/AmtPtpConfigGui/HapticsEngine.cs
@@ -0,0 +1,351 @@
+using System;
+using System.Diagnostics;
+using System.Threading;
+using AmtPtpConfigGui.Native;
+using ActuatorHandle = Microsoft.Win32.SafeHandles.SafeFileHandle;
+
+namespace AmtPtpConfigGui
+{
+    internal enum HapticsState
+    {
+        Disabled,
+        DriverUnavailable,
+        ActuatorUnavailable,
+        FeedUnavailable,
+        Running,
+    }
+
+    internal readonly record struct HapticsStatus(HapticsState State, int Pressure, int Clicks);
+
+    /// <summary>
+    /// Decides when a physical click has also been a firm press. Pure logic,
+    /// no I/O.
+    /// </summary>
+    internal sealed class HapticsLatch
+    {
+        private const int CooldownMs = 250;
+
+        private readonly int _threshold;
+        private readonly int _release;
+        private bool _armed;
+        private int _above;
+        private int _below;
+        private long _last = -1000;
+
+        public HapticsLatch(int threshold)
+        {
+            _threshold = threshold;
+            // 70% hysteresis. Keep in sync with the label next to the
+            // threshold slider (MainWindow.UpdateHapticsLabels).
+            _release = threshold * 7 / 10;
+        }
+
+        public void Reset()
+        {
+            _armed = false;
+            _above = 0;
+            _below = 0;
+        }
+
+        public bool Sample(int pressure, bool valid, bool button, long ms)
+        {
+            if (!valid || pressure <= _release)
+            {
+                _above = 0;
+                if (++_below >= 2)
+                    _armed = true;
+            }
+            else
+            {
+                _below = 0;
+                if (button && pressure >= _threshold)
+                    _above++;
+                else
+                    _above = 0;
+            }
+
+            if (valid && _armed && _above >= 2 && ms - _last >= CooldownMs)
+            {
+                _armed = false;
+                _above = 0;
+                _last = ms;
+                return true;
+            }
+
+            return false;
+        }
+    }
+
+    /// <summary>
+    /// The second haptic click, running inside the control panel: a
+    /// background thread reads the driver's live pressure frames (shared with
+    /// the Live view through DeviceIo.SetLiveConsumer) and, on a firm press
+    /// after the physical click, fires one click through the actuator
+    /// driver. It keeps running while the window is hidden in the tray and
+    /// costs nothing while disabled: the live stream is released and the
+    /// actuator closed.
+    /// </summary>
+    internal sealed class HapticsEngine : IDisposable
+    {
+        private const int PollMs = 8;
+        private const int IdleMs = 250;
+        private const int RetryMs = 500;
+        private const int ActuatorSearchMs = 2000;
+        private const int StaleMs = 250;
+
+        private readonly DeviceIo _device;
+        private readonly CancellationTokenSource _cts = new CancellationTokenSource();
+        private readonly Thread _thread;
+
+        // Shared with TestClick (UI thread); guards _actuator only.
+        private readonly object _actuatorLock = new object();
+        private ActuatorHandle? _actuator;
+        private long _nextActuatorSearchMs;
+
+        // Written by Configure (UI thread), read by the worker.
+        private volatile HapticsConfig _config = new HapticsConfig { Enabled = false };
+
+        private int _state = (int)HapticsState.Disabled;
+        private int _pressure;
+        private int _clicks;
+
+        public HapticsEngine(DeviceIo device)
+        {
+            _device = device;
+            _thread = new Thread(Run)
+            {
+                IsBackground = true,
+                Name = "HapticsEngine",
+            };
+            _thread.Start();
+        }
+
+        public HapticsStatus Status => new HapticsStatus(
+            (HapticsState)Volatile.Read(ref _state),
+            Volatile.Read(ref _pressure),
+            Volatile.Read(ref _clicks));
+
+        /// <summary>Takes effect within one poll interval.</summary>
+        public void Configure(HapticsConfig config)
+        {
+            _config = config.Clamped();
+        }
+
+        /// <summary>
+        /// Fires one click now, saved settings or not, so a waveform can be
+        /// judged before pressing Save. Works while the engine is disabled.
+        /// </summary>
+        public bool TestClick(int waveform)
+        {
+            lock (_actuatorLock)
+            {
+                if (_actuator == null)
+                    OpenActuatorUnsafe();
+                if (_actuator == null)
+                    return false;
+
+                return ClickUnsafe(waveform);
+            }
+        }
+
+        private void Run()
+        {
+            var clock = Stopwatch.StartNew();
+            CancellationToken token = _cts.Token;
+            HapticsConfig applied = _config;
+            var latch = new HapticsLatch(applied.Threshold);
+            uint sequence = 0;
+            long lastFrameMs = 0;
+            bool liveHeld = false;
+
+            try
+            {
+                while (!token.IsCancellationRequested)
+                {
+                    long now = clock.ElapsedMilliseconds;
+                    HapticsConfig cfg = _config;
+
+                    if (!cfg.Enabled)
+                    {
+                        // Nothing to do: let the driver stop assembling live
+                        // frames and give the actuator back.
+                        if (liveHeld)
+                        {
+                            _device.SetLiveConsumer(DeviceIo.LiveConsumer.Haptics, false);
+                            liveHeld = false;
+                        }
+
+                        CloseActuator();
+                        Publish(HapticsState.Disabled, 0);
+                        token.WaitHandle.WaitOne(IdleMs);
+                        continue;
+                    }
+
+                    if (cfg.Threshold != applied.Threshold || cfg.Enabled != applied.Enabled)
+                        latch = new HapticsLatch(cfg.Threshold);
+                    applied = cfg;
+
+                    if (!_device.IsConnected)
+                    {
+                        liveHeld = false;
+                        Publish(HapticsState.DriverUnavailable, 0);
+                        token.WaitHandle.WaitOne(RetryMs);
+                        continue;
+                    }
+
+                    // No actuator, no point streaming frames.
+                    if (!EnsureActuator(now))
+                    {
+                        if (liveHeld)
+                        {
+                            _device.SetLiveConsumer(DeviceIo.LiveConsumer.Haptics, false);
+                            liveHeld = false;
+                        }
+
+                        Publish(HapticsState.ActuatorUnavailable, 0);
+                        token.WaitHandle.WaitOne(RetryMs);
+                        continue;
+                    }
+
+                    // Cheap when nothing changed; re-sent after a reconnect or
+                    // a failed read.
+                    if (!liveHeld)
+                    {
+                        if (!_device.SetLiveConsumer(DeviceIo.LiveConsumer.Haptics, true))
+                        {
+                            Publish(HapticsState.FeedUnavailable, 0);
+                            token.WaitHandle.WaitOne(RetryMs);
+                            continue;
+                        }
+
+                        liveHeld = true;
+                        sequence = 0;
+                        lastFrameMs = now;
+                        latch.Reset();
+                    }
+
+                    if (!_device.TryGetLiveFrame(out LiveFrame frame))
+                    {
+                        liveHeld = false;
+                        Publish(HapticsState.FeedUnavailable, 0);
+                        token.WaitHandle.WaitOne(RetryMs);
+                        continue;
+                    }
+
+                    if (frame.Sequence == sequence)
+                    {
+                        // No new frame. After a quiet spell forget any
+                        // half-seen press so stale samples cannot combine
+                        // with fresh ones.
+                        if (now - lastFrameMs > StaleMs)
+                        {
+                            latch.Reset();
+                            Volatile.Write(ref _pressure, 0);
+                        }
+
+                        token.WaitHandle.WaitOne(PollMs);
+                        continue;
+                    }
+
+                    sequence = frame.Sequence;
+                    lastFrameMs = now;
+
+                    bool valid = frame.ContactCount == 1
+                        && frame.RawContactCount == 1
+                        && frame.LargePalmBlanked == 0
+                        && frame.Contacts[0].Confident != 0
+                        && frame.Contacts[0].PalmSuspect == 0;
+                    int pressure = valid ? frame.Contacts[0].Pressure : 0;
+
+                    Publish(HapticsState.Running, pressure);
+
+                    if (latch.Sample(pressure, valid, frame.ButtonDown != 0, now) && TryClick(cfg.Waveform))
+                        Interlocked.Increment(ref _clicks);
+
+                    token.WaitHandle.WaitOne(PollMs);
+                }
+            }
+            finally
+            {
+                if (liveHeld)
+                    _device.SetLiveConsumer(DeviceIo.LiveConsumer.Haptics, false);
+                CloseActuator();
+            }
+        }
+
+        private void Publish(HapticsState state, int pressure)
+        {
+            Volatile.Write(ref _state, (int)state);
+            Volatile.Write(ref _pressure, pressure);
+        }
+
+        private bool EnsureActuator(long now)
+        {
+            lock (_actuatorLock)
+            {
+                if (_actuator != null)
+                    return true;
+
+                if (now < _nextActuatorSearchMs)
+                    return false;
+
+                OpenActuatorUnsafe();
+                if (_actuator == null)
+                    _nextActuatorSearchMs = now + ActuatorSearchMs;
+                return _actuator != null;
+            }
+        }
+
+        private void OpenActuatorUnsafe()
+        {
+            if (HapticsActuator.Find(out string? path) == HapticsActuator.FindResult.Found && path != null)
+                _actuator = HapticsActuator.Open(path);
+        }
+
+        private void CloseActuator()
+        {
+            lock (_actuatorLock)
+            {
+                _actuator?.Dispose();
+                _actuator = null;
+            }
+        }
+
+        private bool TryClick(int waveform)
+        {
+            lock (_actuatorLock)
+            {
+                return _actuator != null && ClickUnsafe(waveform);
+            }
+        }
+
+        // Returns true when a click was actually delivered. The driver's own
+        // cooldown is flow control; any other failure means the transport is
+        // gone or wedged, so it is dropped and found again later.
+        private bool ClickUnsafe(int waveform)
+        {
+            int error = HapticsActuator.Click(_actuator!, waveform);
+            if (error == 0)
+                return true;
+
+            if (error != HapticsActuator.ErrorBusy)
+            {
+                _actuator!.Dispose();
+                _actuator = null;
+            }
+
+            return false;
+        }
+
+        public void Dispose()
+        {
+            _cts.Cancel();
+
+            // Disposing the token source under a worker that is still waiting
+            // on its handle would throw on that thread; if it did not stop in
+            // time, leave the source to the finalizer instead.
+            if (_thread.Join(1000))
+                _cts.Dispose();
+        }
+    }
+}
