<Window x:Class="AmtPtpConfigGui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AmtPtpConfigGui"
        Title="Wellspring Control Center"
        Icon="Assets/AppIcon.ico"
        Height="820" Width="1280" MinHeight="660" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PageBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ToolTipService.InitialShowDelay="700"
        ToolTipService.ShowDuration="20000"
        ToolTipService.BetweenShowDelay="250" PreviewMouseWheel="Window_PreviewMouseWheel">

    <Window.Resources>

        <!-- =====================================================================
             Design tokens.

             The previous palette was "generic Fluent" (stock Windows blue,
             flat gray page, every card the same visual weight) - it worked,
             but nothing about it was designed *for this app*. This pass
             keeps the same light, native-feeling chrome but:
               - gives the window an actual identity (brand mark + title/
                 subtitle instead of just a status dot),
               - establishes a real type scale instead of one font size
                 everywhere,
               - turns the trackpad preview into a dark "glass device" panel
                 instead of a plain white rectangle, since that's the one
                 element users actually stare at while calibrating,
               - gives primary/secondary/tertiary actions distinct visual
                 weight instead of every button looking the same.
             ===================================================================== -->

        <SolidColorBrush x:Key="AccentBrush"        Color="#2554C7"/>
        <SolidColorBrush x:Key="AccentBrushHover"    Color="#1F45A6"/>
        <SolidColorBrush x:Key="AccentBrushPressed"  Color="#163578"/>
        <SolidColorBrush x:Key="AccentSoftBrush"     Color="#E8EEFC"/>
        <SolidColorBrush x:Key="AccentHaloBrush"     Color="#142554C7"/>
        <SolidColorBrush x:Key="StatusOnlineBrush"   Color="#1D9A6C"/>
        <SolidColorBrush x:Key="StatusOfflineBrush"  Color="#E5484D"/>
        <SolidColorBrush x:Key="StatusIdleBrush"     Color="#996B7280"/>
        <SolidColorBrush x:Key="CardBrush"           Color="#FFFFFF"/>
        <SolidColorBrush x:Key="CardBorderBrush"     Color="#E7E9EC"/>
        <SolidColorBrush x:Key="PageBrush"           Color="#F4F5F7"/>
        <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#14171C"/>
        <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#6B7280"/>
        <SolidColorBrush x:Key="TextTertiaryBrush"   Color="#9AA1AC"/>
        <SolidColorBrush x:Key="DividerBrush"        Color="#ECEDF0"/>
        <SolidColorBrush x:Key="ControlFillBrush"    Color="#FBFBFC"/>
        <SolidColorBrush x:Key="ControlStrokeBrush"  Color="#D8DBE0"/>
        <SolidColorBrush x:Key="DangerBrush"         Color="#E5484D"/>
        <SolidColorBrush x:Key="DangerSoftBrush"     Color="#FCE9EA"/>
        <SolidColorBrush x:Key="SuccessBrush"        Color="#1D9A6C"/>
        <SolidColorBrush x:Key="SuccessSoftBrush"    Color="#E7F6EF"/>

        <LinearGradientBrush x:Key="BrandMarkBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#3A6BF0" Offset="0"/>
            <GradientStop Color="#2554C7" Offset="1"/>
        </LinearGradientBrush>

        <!-- Bezel around the trackpad "device" panel, and the glass shine
             overlay drawn on top of it - see the preview column below.
             Brushed-aluminum silver, like the MacBook's own trackpad body,
             rather than the previous dark "glass device" look. -->
        <LinearGradientBrush x:Key="BezelBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#EEEFF1" Offset="0"/>
            <GradientStop Color="#C9CBCE" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GlassShineBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#40FFFFFF" Offset="0"/>
            <GradientStop Color="#00FFFFFF" Offset="0.45"/>
        </LinearGradientBrush>

        <DropShadowEffect x:Key="CardShadow"
                           Color="#0B0D10" Opacity="0.06"
                           BlurRadius="22" ShadowDepth="2" Direction="270"/>
        <DropShadowEffect x:Key="DeviceShadow"
                           Color="#0B0D10" Opacity="0.22"
                           BlurRadius="26" ShadowDepth="6" Direction="270"/>
        <DropShadowEffect x:Key="ThumbShadow"
                           Color="#000000" Opacity="0.20"
                           BlurRadius="6" ShadowDepth="1" Direction="270"/>
        <DropShadowEffect x:Key="PrimaryButtonShadow"
                           Color="#2554C7" Opacity="0.30"
                           BlurRadius="14" ShadowDepth="3" Direction="270"/>

        <!-- Gentle breathing pulse for the Live telemetry dot - started/
             stopped from code-behind in Live_Changed / SetLiveDot(). -->
        <Storyboard x:Key="LivePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="LiveDot"
                              Storyboard.TargetProperty="Opacity"
                              From="1.0" To="0.32" Duration="0:0:0.9"/>
        </Storyboard>

        <!-- ===================== Base text + type scale ===================== -->
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="TitleText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="SubtitleText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="SectionCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,1,0,0"/>
        </Style>
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
        </Style>
        <!-- Numeric/telemetry readouts get a monospace face - tabular
             figures line up column-to-column as values change, which a
             proportional UI font (Segoe UI) can't do. Small, deliberate
             detail that makes the live readout feel like instrumentation
             instead of a sentence that happens to contain numbers. -->
        <Style x:Key="TelemetryText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <!-- ===================== Card container ===================== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="18,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- ===================== GroupBox re-skinned as a settings card
             with a left accent rule + two-line (title/caption) header,
             set via GroupBox.Header (rich content, not just a string). ==== -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Padding" Value="18,16,18,16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Border Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="3" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}"
                                        Margin="0,16"/>
                                <StackPanel Grid.Column="1" Margin="{TemplateBinding Padding}">
                                    <ContentPresenter ContentSource="Header" Margin="0,0,0,14"/>
                                    <ContentPresenter/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Reusable header content for a settings card: bold title on top,
             muted caption underneath. Used as GroupBox.Header below. -->
        <Style x:Key="SettingsSectionHeader" TargetType="StackPanel"/>

        <!-- Standardizes the vertical rhythm between "label + value" rows
             inside a settings card, so every slider row uses the same
             spacing instead of each one being hand-tuned inline. -->
        <Style x:Key="SettingRow" TargetType="Grid">
            <Setter Property="Margin" Value="0,10,0,4"/>
        </Style>

        <!-- ===================== Slider labels ===================== -->
        <Style TargetType="TextBlock" x:Key="SliderLabel">
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SliderValue">
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>

        <!-- ===================== Slider ===================== -->
        <Style x:Key="FluentSliderThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid>
                            <Ellipse x:Name="Halo" Width="24" Height="24"
                                     Fill="{DynamicResource AccentHaloBrush}" Opacity="0"/>
                            <Ellipse Width="18" Height="18"
                                     Fill="White"
                                     Stroke="{DynamicResource AccentBrush}"
                                     StrokeThickness="2"
                                     Effect="{StaticResource ThumbShadow}"/>
                            <Ellipse x:Name="Core" Width="8" Height="8"
                                     Fill="{DynamicResource AccentBrush}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Halo" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Core" Property="Fill" Value="{DynamicResource AccentBrushPressed}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,3,0,14"/>
            <Setter Property="IsSnapToTickEnabled" Value="True"/>
            <Setter Property="TickPlacement" Value="None"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" Background="{DynamicResource ControlStrokeBrush}" CornerRadius="2"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2">
                                                    <Border.Background>
                                                    <DynamicResource ResourceKey="AccentBrush"/>
                                                </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Opacity="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource FluentSliderThumb}" Width="18" Height="18"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Buttons =====================
             Three tiers: default (secondary, outlined), AccentButton
             (primary - "Save"), GhostButton (tertiary, text-only -
             "Reset to defaults", a destructive-ish but infrequent
             action that shouldn't visually compete with Apply). -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action - "Save". Slightly larger, filled accent,
             soft colored elevation shadow so it visibly outranks every
             other button on screen instead of matching them 1:1. -->
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,9"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrushHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource AccentBrushPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary action: same geometry as the primary action, but a
             neutral filled surface. This keeps Reset and Save visually
             consistent while still giving Save primary emphasis. -->
        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="MinWidth" Value="128"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlPressedBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tertiary action used for small utility buttons only. -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Margin="{TemplateBinding Padding}"
                                               TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ControlFillBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DividerBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== ScrollBars ===================== -->
        <Style x:Key="ModernScrollBarThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ThumbBorder" Background="{DynamicResource ScrollBarThumbBrush}" CornerRadius="4" Margin="2"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollBarThumb}" MinHeight="26"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Height" Value="7"/>
                    <Setter Property="Width" Value="Auto"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="90"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource DangerBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Android-style switches ===================== -->
        <Style x:Key="AndroidSwitch" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid MinWidth="108" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="24"
                                    CornerRadius="12" Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource TextTertiaryBrush}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentContentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox" BasedOn="{StaticResource AndroidSwitch}"/>

        <Style x:Key="AndroidToggle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid MinWidth="108" MinHeight="28">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border x:Name="Track" Grid.Column="1" Width="40" Height="24"
                                    CornerRadius="12" Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                                    HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid>
                                    <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource TextTertiaryBrush}"
                                             HorizontalAlignment="Left" Margin="2,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource AccentContentBrush}"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,2,0"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>



        <Style x:Key="ThemePreviewButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===================== Sentence-length option checkboxes =====================
             AndroidSwitch (above) is the default CheckBox look, and it's the
             right one for a short on/off label like "Live" or "Pro Mode".
             But three checkboxes in this window carry a full descriptive
             sentence ("New contact (birth) - not a continuation...",
             "Require pressure to activate contact"), and a fixed-width
             34+42px switch track has no room for wrapped text - the
             AndroidSwitch template would clip or overflow it. OptionCheckBox
             keeps the same accent color and corner language as the rest of
             the app, but as a conventional wrapping checkbox instead of a
             toggle, so long labels render the way they read. -->
        <Style x:Key="OptionCheckBox" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box" Grid.Column="0" Width="18" Height="18"
                                    CornerRadius="5" Margin="0,1,10,0"
                                    Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1.4"
                                    VerticalAlignment="Top">
                                <Path x:Name="Check" Data="M2,6.5 L6,10.5 L14,2"
                                      Stroke="{DynamicResource AccentContentBrush}" StrokeThickness="2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1"
                                               VerticalAlignment="Center">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Check" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Radio buttons were the one remaining native/unstyled Win32
             control in the window (used for the Force Tap action choice),
             sitting directly below Android-style switches and looking
             completely out of place. Same visual language as
             OptionCheckBox above, just a circular indicator instead of a
             checkmark. -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Circle" Grid.Column="0" Width="18" Height="18"
                                    CornerRadius="9" Margin="0,0,10,0"
                                    Background="{DynamicResource ControlFillBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1.4"
                                    VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="8" Height="8"
                                         Fill="{DynamicResource AccentContentBrush}" Opacity="0"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Circle" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Dot" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>

        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource ControlFillBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                                <Grid>
                                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                                    <Path Data="M 0 0 L 4 4 L 8 0" Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                </Grid>
                            </Border>
                            <!-- Hit-test layer for opening/closing the popup, laid on top of
                                 the visible Field border. It carries no Style, so without an
                                 explicit Template it inherits the OS theme's default ToggleButton
                                 chrome (Aero2/Fluent) - which paints its own blue hover/pressed
                                 highlight rectangle on top of everything else, regardless of the
                                 Background/BorderThickness set here. Giving it a blank
                                 ControlTemplate makes it purely a transparent click target. -->
                            <ToggleButton x:Name="DropDownToggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent"/>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade" VerticalOffset="5">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="4" SnapsToDevicePixels="True">
                                    <ScrollViewer PreviewMouseWheel="SlowScrollViewer_MouseWheel" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Field" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="Field" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernComboBoxItem" TargetType="ComboBoxItem">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemRoot" Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Every ComboBox in the app used to be styled twice: once by the
             implicit TargetType="ComboBox" style and again by this explicit
             "ModernComboBox" style whenever a XAML author remembered to set
             it. The two templates had drifted slightly (different corner
             radius, different popup shadow), so which one you got depended
             on whether Style="{StaticResource ModernComboBox}" was typed on
             that particular control. ModernComboBox is now the single
             source of truth and also the implicit default, so every
             ComboBox/ComboBoxItem looks the same whether or not it opts in
             explicitly. -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource ModernComboBox}"/>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ModernComboBoxItem}"/>

        <!-- ===================== Settings tabs (Palm / Scroll / Pointer) =====================
             A flat, segmented-control look (all tab headers in one rounded
             strip, selected one lifted onto a white "pill") rather than the
             default Win32 folder-tab chrome, to match the rest of the
             settings-card visual language. -->
        <Style x:Key="SettingsTabItem" TargetType="TabItem">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Root"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <ContentPresenter ContentSource="Header"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrushHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentContentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource ControlHoverBrush}"/>
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource ControlStrokeBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsTabControl" TargetType="TabControl">
            <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0"
                                        Background="{DynamicResource ControlFillBrush}"
                                        BorderBrush="{DynamicResource ControlStrokeBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Padding="3"
                                        Margin="0,0,0,14">
                                    <UniformGrid Rows="1" IsItemsHost="True"/>
                                </Border>
                                <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        </Style>

        <Style x:Key="SettingsScrollViewer" TargetType="ScrollViewer">
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid ClipToBounds="False">
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                                    Content="{TemplateBinding Content}"
                                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                    Margin="{TemplateBinding Padding}"
                                                    CanContentScroll="{TemplateBinding CanContentScroll}"
                                                    HorizontalAlignment="Stretch"
                                                    VerticalAlignment="Stretch"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar"
                                       Orientation="Vertical"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       Width="8"
                                       Margin="0,0,-10,0"
                                       Style="{DynamicResource SettingsScrollBar}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                                       Maximum="{TemplateBinding ScrollableHeight}"
                                       ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{TemplateBinding VerticalOffset}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="8"/>
            <Setter Property="MinWidth" Value="8"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Focusable="False" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineUpCommand"
                                                  Background="Transparent" BorderThickness="0"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Background="{DynamicResource TextSecondaryBrush}"
                                           Opacity="0.55" Margin="2,0" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.LineDownCommand"
                                                  Background="Transparent" BorderThickness="0"
                                                  Opacity="0" Focusable="False" IsTabStop="False"/>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <DockPanel LastChildFill="True" Margin="18">

        <!-- ===================== Header: brand + connection status ===================== -->
        <Border x:Name="ProfileBarCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource BrandMarkBrush}">
                        <Grid>
                            <Ellipse Width="9" Height="9" Fill="#B8FFFFFF"
                                     HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,8,0,0"/>
                            <Ellipse Width="13" Height="13" Fill="White"
                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,7"/>
                        </Grid>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                        <TextBlock Text="Wellspring Control Center" Style="{StaticResource TitleText}"/>
                        <TextBlock Text="Calibration settings" Style="{StaticResource SubtitleText}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnReconnect" Visibility="Collapsed" Height="36" Padding="12,0" Margin="0,0,8,0"
                            Style="{StaticResource SecondaryButton}" FontSize="12.5" FontWeight="Normal" Click="Reconnect_Click" ToolTip="Reconnect to the device">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="↻" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Reconnect" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="10,7" Width="132" Height="36">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{DynamicResource StatusOfflineBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center"
                                       FontSize="12.5" FontWeight="Normal"
                                       Text="Disconnected"/>
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="7" Padding="12,7" MinWidth="280" MaxWidth="460" Height="36">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Device:" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0"
                                       VerticalAlignment="Center" FontSize="12.5" FontWeight="Normal"/>
                            <TextBlock x:Name="DeviceModelText" Grid.Column="1" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="12.5" FontWeight="Normal"
                                       TextTrimming="CharacterEllipsis"
                                       Text="No device detected"
                                       ToolTip="Detected Mac/trackpad model"/>
                        </Grid>
                    </Border>
                    <Button x:Name="BtnAppSettings" Width="40" Height="36" MinWidth="40" Margin="8,0,0,0"
                            Padding="0" Background="{DynamicResource ControlFillBrush}"
                            BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontFamily="Segoe MDL2 Assets" FontSize="16"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Click="AppSettings_Click" ToolTip="Application settings">
                        <TextBlock Text="&#xE713;" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===================== Profiles + advanced mode ===================== -->
        <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="175"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Profile" FontWeight="SemiBold" FontSize="12.5"/>
                        <TextBlock Text="Pointer / Scroll / Palm settings" Style="{StaticResource SectionCaption}"/>
                    </StackPanel>
                    <ComboBox x:Name="ProfileCombo" Grid.Column="1"
                              SelectionChanged="ProfileCombo_SelectionChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="＋" Padding="8,0" Width="34" MinWidth="0" Height="36" Margin="0,0,6,0"
                                Click="NewProfile_Click" ToolTip="New profile"/>
                        <Button Content="Rename" Padding="6,0" Width="68" MinWidth="0" Height="36" Margin="0,0,6,0"
                                Click="RenameProfile_Click"/>
                        <Button Content="Delete" Padding="6,0" Width="60" MinWidth="0" Height="36" Margin="0"
                                Click="DeleteProfile_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,10">
                <!-- Pro Mode pinned to the left edge, Debug Logging pinned to the
                     right edge - opposite ends of the card, not next to each other. -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ChkProMode" Grid.Column="0" Content="Pro Mode" Style="{StaticResource AndroidSwitch}"
                              HorizontalAlignment="Left" VerticalAlignment="Center"
                              Checked="ProMode_Changed" Unchecked="ProMode_Changed"/>
                    <CheckBox x:Name="ChkDebugMode" Grid.Column="1" Content="Debug Logging" Style="{StaticResource AndroidSwitch}"
                              HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="Collapsed"
                              Checked="DebugMode_Changed" Unchecked="DebugMode_Changed"
                              ToolTip="Turns on the driver's [AmtPtp] trace output (view with Sysinternals DebugView, run as admin, Capture Kernel + Enable Verbose Kernel Output). Persists across reboot/replug; off by default."/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Toolbar: Live monitor + diagnostics ===================== -->
        <Border x:Name="LiveToolbarCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Height="36" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkLive" Style="{StaticResource AndroidSwitch}" Content="Live"
                                  HorizontalAlignment="Left" VerticalAlignment="Center"
                                  Checked="Live_Changed" Unchecked="Live_Changed"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{DynamicResource StatusIdleBrush}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="LiveStatusText" Text="Live: disabled"
                                       Style="{StaticResource TelemetryText}" Margin="7,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="LiveCornerText" Text="Corners: TL 0 | TR 0 | BL 0 | BR 0"
                                   Style="{StaticResource TelemetryText}" Margin="20,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="BtnExportLog" Content="Export log .txt" Height="36" Click="SaveErrors_Click" Visibility="Collapsed"/>
                        <!-- Expands/collapses the live touch-contact list below.
                             Only meaningful (and only shown) while Live is on;
                             starts collapsed every time Live is (re)enabled so
                             the toolbar stays compact by default. -->
                        <Button x:Name="BtnToggleLiveDetails" Width="36" Height="36" Padding="0"
                                MinWidth="36" FontSize="11"
                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                Visibility="Collapsed" Click="ToggleLiveDetails_Click"
                                ToolTip="Show/hide live touch details">
                            <TextBlock x:Name="BtnToggleLiveDetailsIcon" Text="&#x25BE;" FontSize="12" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border x:Name="LiveCoordPanel" Grid.Row="1" Margin="0,10,0,0" Padding="10,7" Visibility="Collapsed"
                        Background="{DynamicResource ControlFillBrush}"
                        BorderBrush="{DynamicResource ControlStrokeBrush}" BorderThickness="1"
                        CornerRadius="8" Height="116">
                    <ScrollViewer PreviewMouseWheel="SlowScrollViewer_MouseWheel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <TextBlock x:Name="LiveCoordText" Text="Live: no active contacts"
                                   Style="{StaticResource TelemetryText}"
                                   TextWrapping="NoWrap"/>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>

        <!-- ===================== Main content: settings (left, scrollable) + live preview & actions (right) =====================
             The Save/Reset bar used to be a separate full-width DockPanel.Dock="Bottom"
             strip, stretching under both the settings list and the touchpad
             preview even though its buttons only ever sit at the strip's
             right edge. It now lives inside this Grid as its own row, sized
             to exactly the touchpad preview's column (Grid.Column="2") -
             and the settings list (Grid.Column="0"), no longer needing to
             leave headroom for a full-width footer beneath it, spans both
             rows so it gets that reclaimed height instead. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="460"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Spans both rows: with the Save/Reset bar narrowed to just the
                 preview column's width, the settings list now extends down
                 into the height that bar used to reserve underneath it. -->
            <TabControl Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" Style="{StaticResource SettingsTabControl}">
                <TabItem Header="Palm" Style="{StaticResource SettingsTabItem}">
            <ScrollViewer Style="{StaticResource SettingsScrollViewer}" PreviewMouseWheel="SlowScrollViewer_MouseWheel">
                <StackPanel Width="Auto">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Palm rejection at touchpad edges" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="Reject new contacts that begin inside the configured edge zones." Style="{StaticResource HintText}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkPalmEdgeRejection" Grid.Column="1" Style="{StaticResource AndroidSwitch}"
                                      Content="" IsChecked="True" Checked="PalmEdgeRejection_Changed" Unchecked="PalmEdgeRejection_Changed"
                                      VerticalAlignment="Center" Margin="16,0,0,0"/>
                        </Grid>
                    </Border>

                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Edge zone" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="EDGE ZONE · % of touchpad size" Style="{StaticResource SectionCaption}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Top" ToolTip="Top edge rejection zone. New contacts appearing inside this percentage of the touchpad height are treated as palm immediately. Increase it to reject more accidental edge contacts; decrease it to preserve more edge taps."/>
                                <TextBlock x:Name="LblEdgeTop" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeTop" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Left" ToolTip="Left edge rejection zone. New contacts inside this percentage of the touchpad width are treated as palm immediately. Increase it for stronger protection near the left edge; decrease it if edge touches are being rejected too often."/>
                                <TextBlock x:Name="LblEdgeLeft" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeLeft" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Right" ToolTip="Right edge rejection zone. New contacts inside this percentage of the touchpad width are treated as palm immediately. Increase it for stronger protection near the right edge; decrease it if edge touches are being rejected too often."/>
                                <TextBlock x:Name="LblEdgeRight" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeRight" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Bottom" ToolTip="Bottom edge rejection zone. New contacts appearing inside this percentage of the touchpad height are treated as palm immediately. Increase it for stronger protection near the bottom edge; decrease it to keep more bottom-edge contacts."/>
                                <TextBlock x:Name="LblEdgeBottom" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlEdgeBottom" Minimum="0" Maximum="400" ValueChanged="Slider_Changed"/>

                            <TextBlock Style="{StaticResource HintText}"
                                       Text="A new contact appearing in this zone is immediately rejected as palm, regardless of shape."/>
                        </StackPanel>
                    </GroupBox>

                    <GroupBox>
                        <GroupBox.Header>
                            <StackPanel>
                                <TextBlock Text="Palm shape thresholds" Style="{StaticResource SectionTitle}"/>
                                <TextBlock Text="PALM SHAPE" Style="{StaticResource SectionCaption}"/>
                            </StackPanel>
                        </GroupBox.Header>
                        <StackPanel>
                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Major (hard reject)" ToolTip="Hard palm rejection threshold based on the contact major axis. Contacts at or above this size receive a strong palm penalty/rejection. Increase it to reject only very large contacts; decrease it to reject large contacts earlier."/>
                                <TextBlock x:Name="LblLargeMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeMajor" Minimum="50" Maximum="800" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Large Ratio, Major/Minor ×100" ToolTip="Shape-ratio threshold used to identify broad palm-like contacts. The value represents Major/Minor multiplied by 100. Higher values require a more elongated contact before this test activates; lower values make the test more sensitive."/>
                                <TextBlock x:Name="LblLargeRatio" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlLargeRatio" Minimum="100" Maximum="500" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Score Threshold" ToolTip="Minimum accumulated palm score required for the contact to be classified as palm. Increase it to make palm rejection more conservative; decrease it to reject suspicious contacts more aggressively."/>
                                <TextBlock x:Name="LblScoreThresh" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlScoreThresh" Minimum="5" Maximum="150" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Minimum Major" ToolTip="Minimum contact major axis used by palm heuristics. Smaller contacts are excluded from this test. Increase it to ignore more small finger contacts; decrease it to let smaller contacts participate in the heuristic."/>
                                <TextBlock x:Name="LblMinMajor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMajor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>

                            <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource SliderLabel}" Text="Minimum Minor" ToolTip="Minimum contact minor axis used by palm heuristics. Smaller contacts are excluded from this test. Increase it to ignore very narrow contacts; decrease it to include narrower contacts."/>
                                <TextBlock x:Name="LblMinMinor" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                            </Grid>
                            <Slider x:Name="SlMinMinor" Minimum="0" Maximum="300" ValueChanged="Slider_Changed"/>
                        </StackPanel>
                    </GroupBox>



                </StackPanel>
            </ScrollViewer>
                </TabItem>

                <TabItem Header="Scroll" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer Style="{StaticResource SettingsScrollViewer}" PreviewMouseWheel="SlowScrollViewer_MouseWheel">
                        <StackPanel Width="Auto">
                            <GroupBox>
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Scroll" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="SCROLL · basic settings" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Scroll speed" ToolTip="Base two-finger scroll scale expressed as a percentage. 100% is the neutral scale; lower values make scrolling slower and higher values make it faster."/>
                                        <TextBlock x:Name="LblScrollSpeed" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollSpeed" Minimum="20" Maximum="200" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Smoothing" ToolTip="Two-finger scroll smoothing. Higher values blend more history into the current delta, reducing jitter and abrupt changes but making direction changes feel less immediate."/>
                                        <TextBlock x:Name="LblScrollSmoothing" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollSmoothing" Minimum="0" Maximum="100" ValueChanged="ScrollSlider_Changed"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="Higher speed makes two-finger scrolling faster; higher smoothing removes small jitter."/>
                                </StackPanel>
                            </GroupBox>
                            <GroupBox x:Name="ScrollAdvancedPanel" Visibility="Collapsed">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Scroll · Pro" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="PRO · advanced gesture behavior" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast movement speed" ToolTip="Additional scroll scale used while two-finger movement is classified as fast. This is applied instead of the base speed for fast swipes. Higher values make quick swipes travel farther."/>
                                        <TextBlock x:Name="LblScrollFastSpeed" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollFastSpeed" Minimum="20" Maximum="250" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Dead zone" ToolTip="Fallback/medium-speed scroll dead zone. Small motion below this threshold is ignored to suppress tiny sensor noise. Higher values reduce jitter but can make scrolling start later."/>
                                        <TextBlock x:Name="LblScrollDeadzone" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollDeadzone" Minimum="0" Maximum="8" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast movement threshold" ToolTip="Velocity above which pointer motion is classified as fast. Fast motion uses the fast dead zone behavior. Lower it to enter the fast bucket sooner; higher it to require a faster movement."/>
                                        <TextBlock x:Name="LblScrollFastVelocity" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollFastVelocity" Minimum="500" Maximum="4000" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Base scale numerator" ToolTip="Numerator of the advanced base scroll multiplier. The effective base scale is Numerator / Denominator. Increase it to increase scroll distance per frame."/>
                                        <TextBlock x:Name="LblScrollScaleNum" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollScaleNum" Minimum="1" Maximum="400" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Base scale denominator" ToolTip="Denominator of the advanced base scroll multiplier. The effective base scale is Numerator / Denominator. Increase it to reduce the resulting base scale when the numerator stays unchanged."/>
                                        <TextBlock x:Name="LblScrollScaleDen" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollScaleDen" Minimum="1" Maximum="400" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast scale numerator" ToolTip="Numerator of the advanced fast-scroll multiplier. The effective fast scale is Numerator / Denominator. Increase it to make fast swipes travel farther."/>
                                        <TextBlock x:Name="LblScrollScaleNumFast" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollScaleNumFast" Minimum="1" Maximum="400" ValueChanged="ScrollSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast scale denominator" ToolTip="Denominator of the advanced fast-scroll multiplier. The effective fast scale is Numerator / Denominator. Increase it to reduce fast-scroll gain when the numerator stays unchanged."/>
                                        <TextBlock x:Name="LblScrollScaleDenFast" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlScrollScaleDenFast" Minimum="1" Maximum="400" ValueChanged="ScrollSlider_Changed"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="Scale values are advanced fixed-point multipliers applied on top of the basic speed controls."/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Pointer" Style="{StaticResource SettingsTabItem}">
                    <ScrollViewer Style="{StaticResource SettingsScrollViewer}" PreviewMouseWheel="SlowScrollViewer_MouseWheel">
                        <StackPanel Width="Auto">
                            <GroupBox>
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Pointer" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="POINTER · basic settings" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Cursor speed" ToolTip="Base pointer movement scale expressed as a percentage. 100% is neutral; lower values slow the cursor and higher values increase cursor travel for the same finger motion."/>
                                        <TextBlock x:Name="LblCursorSpeed" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorSpeed" Minimum="50" Maximum="200" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Smoothing" ToolTip="Cursor movement smoothing. Higher values blend more history into the current delta, reducing jitter and abrupt changes but making pointer movement feel less immediate."/>
                                        <TextBlock x:Name="LblCursorSmoothing" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorSmoothing" Minimum="0" Maximum="100" ValueChanged="PointerSlider_Changed"/>
                                    <TextBlock Style="{StaticResource HintText}" Text="Speed scales cursor movement; smoothing removes small jitter."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="SmallContactRejectionGroup" Margin="0,12,0,0">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Contact Rejection" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="NON-FORCE TOUCH · small-contact filter" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <CheckBox x:Name="ChkSmallContactRejection" Style="{StaticResource OptionCheckBox}" Margin="0,10,0,4" Content="Enable birth-only rejection" Checked="SmallContactRejectionOption_Changed" Unchecked="SmallContactRejectionOption_Changed" ToolTip="On trackpads without Force Touch, reject a new contact while Major is below M AND Minor is below 60. Once it reaches that size, the contact remains accepted until it is lifted - only checked at birth, never again while tracked. Independent of the continuous filter below."/>
                                    <StackPanel x:Name="SmallContactBirthMajorPanel" Visibility="Collapsed">
                                        <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="M (Major) threshold - birth" ToolTip="Minimum Major-axis contact size ('M') required for a brand-new contact to be accepted. Minor keeps a fixed floor of 60."/>
                                            <TextBlock x:Name="LblSmallContactBirthMajorThreshold" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                        </Grid>
                                        <Slider x:Name="SlSmallContactBirthMajorThreshold" Minimum="10" Maximum="150" ValueChanged="PointerSlider_Changed"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" Text="Checked only when a contact starts (Major ≥ M AND Minor ≥ 60); accepted contacts are never re-checked."/>

                                    <CheckBox x:Name="ChkSmallContactRejectionStrict" Style="{StaticResource OptionCheckBox}" Margin="0,4,0,4" Content="Enable continuous rejection" Checked="SmallContactRejectionOption_Changed" Unchecked="SmallContactRejectionOption_Changed" ToolTip="On trackpads without Force Touch, a contact is ignored on every frame unless Major is at least M AND Minor is at least 30. If either value drops below the threshold while you move, the contact is ignored until it qualifies again. Independent of the birth-only filter above."/>
                                    <StackPanel x:Name="SmallContactMajorPanel" Visibility="Collapsed">
                                        <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="M (Major) threshold - continuous" ToolTip="Minimum Major-axis contact size ('M') required on every frame. Minor keeps a fixed floor of 30."/>
                                            <TextBlock x:Name="LblSmallContactMajorThreshold" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                        </Grid>
                                        <Slider x:Name="SlSmallContactMajorThreshold" Minimum="10" Maximum="150" ValueChanged="PointerSlider_Changed"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Text="Checked every frame while tracked (Major ≥ M AND Minor ≥ 30); can be used with or without birth-only above."/>
                                </StackPanel>
                            </GroupBox>


                            <GroupBox x:Name="ForceTouchGroup" Margin="0,12,0,0">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Touch" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="PRESSURE · hard press behavior" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Force touch threshold" ToolTip="Pressure threshold used to recognize a Force Touch event. Increase it to require a harder press; decrease it to trigger Force Touch with less pressure."/>
                                        <TextBlock x:Name="LblForceTapThreshold" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlForceTapThreshold" Minimum="200" Maximum="400" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Drag cancel distance" ToolTip="How far the contact may drift from where the press started before Force Touch is cancelled and treated as an ordinary drag instead. Raw sensor units, not pixels."/>
                                        <TextBlock x:Name="LblForceTapDragLockoutDistance" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlForceTapDragLockoutDistance" Minimum="40" Maximum="400" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="PointerSlider_Changed"/>
                                    <CheckBox x:Name="ChkForceTouchEnabled" Style="{StaticResource OptionCheckBox}" Margin="0,10,0,4" Content="Enable Force Touch" Checked="ForceTouchOption_Changed" Unchecked="ForceTouchOption_Changed" ToolTip="Master switch for Force Touch on trackpads that support it. When on, the three options below become available and each can be turned on or off independently. When off, none of them has any effect. On standard trackpads the driver ignores this setting."/>
                                    <CheckBox x:Name="ChkForceTouchAction" Style="{StaticResource OptionCheckBox}" Margin="18,4,0,4" Content="Force Touch action" Checked="ForceTouchOption_Changed" Unchecked="ForceTouchOption_Changed" ToolTip="A hard press (Force Touch) triggers the Force Tap action chosen below. Turn this off to keep the pressure options below working without any Force Tap action being sent."/>
                                    <CheckBox x:Name="ChkRequirePressure" Style="{StaticResource OptionCheckBox}" Margin="18,4,0,4" Content="Require pressure to activate contact" Checked="ForceTouchOption_Changed" Unchecked="ForceTouchOption_Changed" ToolTip="For Force Touch-capable trackpads, a brand-new contact with zero pressure is ignored until pressure becomes positive. Existing contacts are unaffected."/>
                                    <CheckBox x:Name="ChkRequirePressureContinuously" Style="{StaticResource OptionCheckBox}" Margin="18,4,0,8" Content="Require pressure continuously" Checked="ForceTouchOption_Changed" Unchecked="ForceTouchOption_Changed" ToolTip="For Force Touch-capable trackpads, a contact is ignored on every frame while pressure is zero. If pressure disappears while you move, the contact is treated as absent until pressure becomes positive again."/>
                                    <TextBlock x:Name="LblForceTapAction" Text="Force Tap action" Style="{StaticResource SliderLabel}" Margin="0,10,0,6" ToolTip="Action emitted when Force Touch is recognized. Choose the mouse action that best matches how you want a hard press to behave."/>
                                    <StackPanel x:Name="ForceTapActionPanel">
                                        <RadioButton x:Name="RbActionContextMenu" Content="Context menu" GroupName="ForceTapAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Open the context menu, equivalent to a right-click."/>
                                        <RadioButton x:Name="RbActionMiddleClick" Content="Middle mouse button" GroupName="ForceTapAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Send a middle mouse button click."/>
                                        <RadioButton x:Name="RbActionDoubleClick" Content="Double click" GroupName="ForceTapAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Send a double left-click."/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="Force Touch settings are available in the normal mode; Pro Mode contains only the lower-level pointer tuning parameters."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="ForceTouchSmallContactRejectionGroup" Margin="0,12,0,0">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Contact Rejection" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="FORCE TOUCH · small-contact filter" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <CheckBox x:Name="ChkForceTouchSmallContactRejection" Style="{StaticResource OptionCheckBox}" Margin="0,10,0,4" Content="Enable birth-only rejection" Checked="ForceTouchSmallContactRejectionOption_Changed" Unchecked="ForceTouchSmallContactRejectionOption_Changed" ToolTip="On Force Touch trackpads, reject a new contact while Major is below M AND Minor is below 60. Once it reaches that size, the contact remains accepted until it is lifted - only checked at birth, never again while tracked. Runs in addition to the pressure gate above, and independent of the continuous filter below. Off by default."/>
                                    <StackPanel x:Name="ForceTouchSmallContactBirthMajorPanel" Visibility="Collapsed">
                                        <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="M (Major) threshold - birth" ToolTip="Minimum Major-axis contact size ('M') required for a brand-new contact to be accepted. Minor keeps a fixed floor of 60."/>
                                            <TextBlock x:Name="LblForceTouchSmallContactBirthMajorThreshold" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                        </Grid>
                                        <Slider x:Name="SlForceTouchSmallContactBirthMajorThreshold" Minimum="10" Maximum="150" ValueChanged="PointerSlider_Changed"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8" Text="Checked only when a contact starts (Major ≥ M AND Minor ≥ 60); accepted contacts are never re-checked."/>

                                    <CheckBox x:Name="ChkForceTouchSmallContactRejectionStrict" Style="{StaticResource OptionCheckBox}" Margin="0,4,0,4" Content="Enable continuous rejection" Checked="ForceTouchSmallContactRejectionOption_Changed" Unchecked="ForceTouchSmallContactRejectionOption_Changed" ToolTip="On Force Touch trackpads, a contact is ignored on every frame unless Major is at least M AND Minor is at least 30. If either value drops below the threshold while you move, the contact is ignored until it qualifies again. Runs in addition to the pressure gate above, and independent of the birth-only filter above. Off by default."/>
                                    <StackPanel x:Name="ForceTouchSmallContactMajorPanel" Visibility="Collapsed">
                                        <Grid Style="{StaticResource SettingRow}" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="M (Major) threshold - continuous" ToolTip="Minimum Major-axis contact size ('M') required on every frame. Minor keeps a fixed floor of 30."/>
                                            <TextBlock x:Name="LblForceTouchSmallContactMajorThreshold" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                        </Grid>
                                        <Slider x:Name="SlForceTouchSmallContactMajorThreshold" Minimum="10" Maximum="150" ValueChanged="PointerSlider_Changed"/>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource HintText}" Text="Checked every frame while tracked (Major ≥ M AND Minor ≥ 30); can be used with or without birth-only above, and alongside the pressure gate."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="ForceTouchEmulationGroup" Margin="0,12,0,0" Visibility="Collapsed">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Force Touch Emulation" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="NON-FORCE TOUCH · Hard Tap-and-hold" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <CheckBox x:Name="ChkForceTouchEmulationEnabled" Style="{StaticResource OptionCheckBox}" Margin="0,10,0,4" Content="Enable Force Touch emulation" Checked="ForceTouchEmulationOption_Changed" Unchecked="ForceTouchEmulationOption_Changed" ToolTip="On trackpads with no pressure sensor, hold a Hard Tap (a mechanical click) for the configured duration to trigger a Force Touch action, instead of releasing it right away."/>
                                    <TextBlock Text="Force Touch emulation action" Style="{StaticResource SliderLabel}" Margin="0,10,0,6" ToolTip="Action emitted once the hold duration is reached. Choose the mouse action that best matches how you want a held Hard Tap to behave."/>
                                    <StackPanel x:Name="ForceTouchEmulationActionPanel">
                                        <RadioButton x:Name="RbEmulationActionContextMenu" Content="Context menu" GroupName="ForceTouchEmulationAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Open the context menu, equivalent to a right-click."/>
                                        <RadioButton x:Name="RbEmulationActionMiddleClick" Content="Middle mouse button" GroupName="ForceTouchEmulationAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Send a middle mouse button click."/>
                                        <RadioButton x:Name="RbEmulationActionDoubleClick" Content="Double click" GroupName="ForceTouchEmulationAction" Margin="0,4" Checked="PointerAction_Changed" ToolTip="Send a double left-click."/>
                                    </StackPanel>
                                    <Grid x:Name="ForceTouchEmulationHoldRow" Style="{StaticResource SettingRow}" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Hold duration" ToolTip="How long a Hard Tap must be held before the emulated Force Touch action fires. Releasing earlier than this behaves as an ordinary click."/>
                                        <TextBlock x:Name="LblForceTouchEmulationHoldMs" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlForceTouchEmulationHoldMs" Minimum="200" Maximum="2000" SmallChange="50" LargeChange="50" IsSnapToTickEnabled="True" TickFrequency="50" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Drag cancel distance" ToolTip="How far the contact may drift from where the Hard Tap started before the emulation timer is cancelled and treated as an ordinary drag instead. Raw sensor units, not pixels."/>
                                        <TextBlock x:Name="LblForceTouchEmulationDragLockoutDistance" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlForceTouchEmulationDragLockoutDistance" Minimum="40" Maximum="400" SmallChange="10" LargeChange="10" IsSnapToTickEnabled="True" TickFrequency="10" ValueChanged="PointerSlider_Changed"/>
                                    <TextBlock Style="{StaticResource HintText}" Margin="0,8,0,0" Text="Available only on trackpads without hardware Force Touch (no pressure sensor). This does not change or interfere with real Force Touch hardware."/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox x:Name="PointerAdvancedPanel" Visibility="Collapsed">
                                <GroupBox.Header>
                                    <StackPanel>
                                        <TextBlock Text="Pointer · Pro" Style="{StaticResource SectionTitle}"/>
                                        <TextBlock Text="PRO · advanced thresholds, deadzone and smoothing" Style="{StaticResource SectionCaption}"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Dead zone" ToolTip="Fallback/medium-speed scroll dead zone. Small motion below this threshold is ignored to suppress tiny sensor noise. Higher values reduce jitter but can make scrolling start later."/>
                                        <TextBlock x:Name="LblCursorDeadzone" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorDeadzone" Minimum="0" Maximum="8" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Slow movement threshold" ToolTip="Velocity below which pointer motion is classified as slow. Slow motion uses the slow dead zone and slow-motion smoothing rules. Increase it to classify more motion as slow."/>
                                        <TextBlock x:Name="LblCursorSlowVelocity" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorSlowVelocity" Minimum="20" Maximum="300" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast movement threshold" ToolTip="Velocity above which pointer motion is classified as fast. Fast motion uses the fast dead zone behavior. Lower it to enter the fast bucket sooner; higher it to require a faster movement."/>
                                        <TextBlock x:Name="LblCursorFastVelocity" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorFastVelocity" Minimum="200" Maximum="2000" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Slow dead zone" ToolTip="Dead zone used for slow pointer movement. Small motion below this value is suppressed to remove stationary-hand jitter. Higher values feel steadier but can delay the start of very small movements."/>
                                        <TextBlock x:Name="LblCursorDeadzoneSlow" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorDeadzoneSlow" Minimum="0" Maximum="8" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Fast dead zone" ToolTip="Dead zone used for fast pointer movement. It is commonly kept low or zero so fast pointer movement does not feel delayed. Increase only if fast motion shows unwanted noise."/>
                                        <TextBlock x:Name="LblCursorDeadzoneFast" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlCursorDeadzoneFast" Minimum="0" Maximum="8" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Smoothing denominator" ToolTip="Denominator used by the pointer smoothing filter. It is part of the fixed-point smoothing formula. Changing it changes the weight scale of the smoothing calculation and should be treated as an advanced tuning parameter."/>
                                        <TextBlock x:Name="LblSmoothingAlphaDen" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlSmoothingAlphaDen" Minimum="1" Maximum="16" ValueChanged="PointerSlider_Changed"/>
                                    <Grid Style="{StaticResource SettingRow}"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="Slow smoothing numerator" ToolTip="Numerator used by the smoothing filter for slow/near-stationary movement. Higher values increase the influence of the smoothing path and reduce jitter; lower values preserve faster response."/>
                                        <TextBlock x:Name="LblSmoothingAlphaNumSlow" Grid.Column="1" Style="{StaticResource SliderValue}"/>
                                    </Grid>
                                    <Slider x:Name="SlSmoothingAlphaNumSlow" Minimum="1" Maximum="16" ValueChanged="PointerSlider_Changed"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- ===================== Live visualization ===================== -->
            <Border x:Name="PreviewCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource Card}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="Touchpad" Style="{StaticResource SectionTitle}" FontSize="16" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- "Device" bezel around the trackpad glass: a silver
                         brushed-aluminum frame (like the MacBook's own
                         trackpad body) with a soft drop shadow, containing
                         the canvas the driver-accurate classification is
                         drawn on, plus a faint diagonal glass-shine overlay.
                         The canvas itself is filled in code (DrawPreview)
                         with a silver "glass" gradient (GlassPadBrush)
                         rather than a flat white rectangle. -->
                    <Border Grid.Row="1" CornerRadius="16" Background="{DynamicResource BezelBrush}"
                            Padding="14" Effect="{StaticResource DeviceShadow}">
                        <Grid>
                            <Border CornerRadius="10" ClipToBounds="True">
                                <Viewbox Stretch="Uniform">
                                    <Grid Width="700" Height="460">
                                        <Canvas x:Name="PreviewCanvas" Width="700" Height="460" Background="Transparent"/>
                                        <!-- Separate layer for the live-touch overlay (footprints/labels).
                                             Kept apart from PreviewCanvas so a live tick only has to move a
                                             handful of pooled shapes here instead of clearing+rebuilding the
                                             whole static background (pad and edge zones) 20-30 times a second -
                                             see DrawLiveOverlay in the code-behind. -->
                                        <local:LiveOverlayControl x:Name="LiveOverlayCanvas" Width="700" Height="460"
                                                  IsHitTestVisible="False"/>
                                    </Grid>
                                </Viewbox>
                            </Border>
                            <Border CornerRadius="10" Background="{DynamicResource GlassShineBrush}" IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                </Grid>
            </Border>

            <!-- ===================== Bottom action bar =====================
                 Same width as the touchpad preview above it (same column),
                 rather than stretching under the settings list too. -->
            <Border x:Name="BottomActionCard" Grid.Column="2" Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="BottomStatusText" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" Text="" TextTrimming="CharacterEllipsis"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Reset to defaults" Style="{StaticResource SecondaryButton}" Click="ResetDefaults_Click" Width="150" Height="40" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource AccentButton}" Click="Save_Click" Width="150" Height="40" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="✓" FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Save" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
