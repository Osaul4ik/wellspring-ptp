#include <windows.h>
#include <ntverp.h>

// Standard WDK version resource. ntverp.h supplies Microsoft's strings and
// build number; the identity below replaces them.
#define VER_FILETYPE             VFT_DRV
#define VER_FILESUBTYPE          VFT2_DRV_SYSTEM

#undef  VER_COMPANYNAME_STR
#define VER_COMPANYNAME_STR      "Osaul4ik"

#undef  VER_PRODUCTNAME_STR
#define VER_PRODUCTNAME_STR      "Wellspring Haptic Actuator Driver"

#undef  VER_LEGALCOPYRIGHT_STR
#define VER_LEGALCOPYRIGHT_STR   "Copyright (C) Osaul4ik 2026"

#undef  VER_PRODUCTVERSION
#define VER_PRODUCTVERSION       1,0,0,0

#undef  VER_PRODUCTVERSION_STR
#define VER_PRODUCTVERSION_STR   "1.0.0.0"

#define VER_FILEDESCRIPTION_STR  "Wellspring Haptic Actuator Kernel Mode Driver"
#define VER_INTERNALNAME_STR     "AmtHapticDeviceUsbKm.sys"
#define VER_ORIGINALFILENAME_STR "AmtHapticDeviceUsbKm.sys"

#include "common.ver"
